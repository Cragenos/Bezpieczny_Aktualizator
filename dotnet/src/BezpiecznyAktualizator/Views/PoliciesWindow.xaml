<Window x:Class="BezpiecznyAktualizator.Views.PoliciesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services"
        Title="{l:Tr 'Zasady aktualizacji'}"
        Width="820" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,16">
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE8D7;" FontSize="28"
                               Margin="0,2,16,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{l:Tr 'Zasady obowiązują przy aktualizacjach uruchamianych w oknie programu i w harmonogramie cichych aktualizacji. Programy wykluczone nigdy nie są aktualizowane, a wstrzymane pozostają na wybranej wersji.'}" />
                </DockPanel>

                <Border x:Name="MachineCard" Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" Margin="0,2,10,0"
                                   VerticalAlignment="Top" />
                        <TextBlock x:Name="MachineText" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Zaufane źródła'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:Tr 'Automatycznie instaluj tylko ze źródeł o zaufaniu:'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="TrustBox" Width="220"
                                      AutomationProperties.Name="{l:Tr 'Automatycznie instaluj tylko ze źródeł o zaufaniu:'}">
                                <ComboBoxItem Content="{l:Tr 'Wysokim'}" />
                                <ComboBoxItem Content="{l:Tr 'Wysokim lub średnim'}" />
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="ManualTrustBox" Margin="0,8,0,0"
                                  Content="{l:Tr 'Także ręczne aktualizacje wymagają zaufanego źródła (pozostałe są pomijane)'}"
                                  ToolTip="{l:Tr 'Przed aktualizacją nieocenione źródła są automatycznie oceniane; pakiety ze źródeł o niższym zaufaniu są pomijane.'}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Padding="10,3" Click="AddExclusion_Click" Content="{l:Tr 'Dodaj'}" />
                                <Button Padding="10,3" Margin="6,0,0,0" Click="RemoveExclusion_Click" Content="{l:Tr 'Usuń'}" />
                            </StackPanel>
                            <TextBlock Text="{l:Tr 'Wykluczone programy'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="ExcludedGrid" Style="{StaticResource Grid}" IsReadOnly="False" Height="150"
                                  SelectionMode="Single" BeginningEdit="Grid_BeginningEdit"
                                  AutomationProperties.Name="{l:Tr 'Wykluczone programy'}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:Tr 'Identyfikator pakietu'}" Binding="{Binding WingetId}" Width="220" />
                                <DataGridTextColumn Header="{l:Tr 'Nazwa'}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{l:Tr 'Powód'}" Binding="{Binding Reason}" Width="*" />
                                <DataGridTextColumn Header="{l:Tr 'Źródło zasady'}" Binding="{Binding Origin}" Width="110" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,12,0,0">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Padding="10,3" Click="AddHold_Click" Content="{l:Tr 'Dodaj'}" />
                                <Button Padding="10,3" Margin="6,0,0,0" Click="RemoveHold_Click" Content="{l:Tr 'Usuń'}" />
                            </StackPanel>
                            <TextBlock Text="{l:Tr 'Wstrzymane wersje'}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <DataGrid x:Name="HoldsGrid" Style="{StaticResource Grid}" IsReadOnly="False" Height="150"
                                  SelectionMode="Single" BeginningEdit="Grid_BeginningEdit"
                                  AutomationProperties.Name="{l:Tr 'Wstrzymane wersje'}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:Tr 'Identyfikator pakietu'}" Binding="{Binding WingetId}" Width="200" />
                                <DataGridTextColumn Header="{l:Tr 'Nazwa'}" Binding="{Binding Name}" Width="*" />
                                <DataGridTextColumn Header="{l:Tr 'Wersja'}" Binding="{Binding Version}" Width="100" />
                                <DataGridTextColumn Header="{l:Tr 'Do dnia'}" Binding="{Binding Until}" Width="100" />
                                <DataGridTextColumn Header="{l:Tr 'Powód'}" Binding="{Binding Reason}" Width="*" />
                                <DataGridTextColumn Header="{l:Tr 'Źródło zasady'}" Binding="{Binding Origin}" Width="110" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{l:Tr 'Wersja: puste pole - program zostaje na zainstalowanej wersji; wzorzec z gwiazdką (np. 24.*) - dozwolone są tylko aktualizacje w tej gałęzi; konkretny numer - dozwolona jest tylko ta wersja. Do dnia (RRRR-MM-DD, opcjonalnie) - po tej dacie wstrzymanie przestaje obowiązywać.'}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{l:Tr 'Microsoft Store nie gwarantuje instalacji wskazanej wersji. Aktywne wstrzymanie blokuje aktualizację.'}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="{l:Tr 'Automatyczne aktualizacje w Microsoft Store nie podlegają zasadom tego programu.'}" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="MachineHint" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,16" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Padding="14,6" Click="Export_Click"
                        ToolTip="{l:Tr 'Zapisuje zasady do pliku JSON, który administrator może umieścić jako zasady komputera.'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xEDE1;" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr 'Eksportuj...'}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:Tr 'Zapisz'}" MinWidth="96" Padding="16,6" Margin="8,0,0,0"
                            Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Save_Click" />
                    <Button Content="{l:Tr 'Anuluj'}" MinWidth="96" Padding="16,6" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
