<UserControl x:Class="BezpiecznyAktualizator.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services">
    <DockPanel Margin="4,12,4,4">
        <WrapPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Style="{StaticResource ToolButton}" Tag="&#xE72C;" Content="{l:Tr 'Skanuj sterowniki'}" Click="Scan_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE895;" Content="{l:Tr 'Szukaj aktualizacji (Windows Update)'}" Click="Search_Click" />
            <Button Style="{StaticResource AccentToolButton}" Tag="&#xE896;" Content="{l:Tr 'Instaluj zaznaczone'}" Click="InstallSelected_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE896;" Content="{l:Tr 'Instaluj wszystkie dostępne'}" Click="InstallAll_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE8F1;" Content="{l:Tr 'Katalog Microsoft Update'}" Click="Catalog_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE770;" Content="{l:Tr 'Menedżer urządzeń'}" Click="DeviceManager_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE78C;" Content="{l:Tr 'Eksportuj raport'}" Click="Export_Click" />
        </WrapPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" Margin="0,0,8,0" />
            <TextBlock Text="{l:Tr 'Filtr:'}" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="240" Margin="8,0,16,0" VerticalContentAlignment="Center"
                     TextChanged="Filter_Changed" />
            <CheckBox x:Name="OnlyUpdates" Content="{l:Tr 'Tylko z aktualizacją lub problemem'}" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <CheckBox x:Name="HideGeneric" Content="{l:Tr 'Ukryj ogólne sterowniki systemu Windows'}" VerticalAlignment="Center"
                      Margin="12,0,0,0" Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <CheckBox x:Name="RestorePoint" Content="{l:Tr 'Punkt przywracania przed instalacją'}" IsChecked="True"
                      VerticalAlignment="Center" Margin="12,0,0,0" />
            <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Style="{StaticResource Secondary}" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="2,8,2,0">
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Visibility="Hidden" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" Text="{l:Tr 'Gotowy.'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="120" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" MinHeight="80" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="Table" Style="{StaticResource Grid}" RowStyle="{StaticResource StatusRow}" SelectionChanged="Table_SelectionChanged"
                      Sorting="Table_Sorting">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr 'Urządzenie'}" Binding="{Binding DeviceName}" Width="2*" MinWidth="200" />
                    <DataGridTextColumn Header="{l:Tr 'Klasa'}" Binding="{Binding DeviceClass}" Width="110" />
                    <DataGridTextColumn Header="{l:Tr 'Wersja'}" Binding="{Binding Version}" Width="120" />
                    <DataGridTextColumn Header="{l:Tr 'Data'}" Binding="{Binding Date}" Width="90" />
                    <DataGridTextColumn Header="{l:Tr 'Nowa wersja'}" Binding="{Binding AvailableDisplay}" Width="120" />
                    <DataGridTextColumn Header="{l:Tr 'Status'}" Binding="{Binding Status}" Width="150" />
                    <DataGridTextColumn Header="{l:Tr 'Dostawca'}" Binding="{Binding ProviderDisplay}" Width="*" MinWidth="120" />
                    <DataGridTextColumn Header="{l:Tr 'Podpis'}" Binding="{Binding SignatureText}" Width="150" />
                    <DataGridTextColumn Header="{l:Tr 'Zaufanie'}" Binding="{Binding SecurityLevelDisplay}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
            <TabControl x:Name="BottomTabs" Grid.Row="2">
                <TabItem Header="{l:Tr 'Szczegóły i ocena bezpieczeństwa'}">
                    <TextBox x:Name="Details" Style="{StaticResource LogBox}" />
                </TabItem>
                <TabItem Header="{l:Tr 'Dziennik'}">
                    <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
