<UserControl x:Class="BezpiecznyAktualizator.Views.WindowsUpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:BezpiecznyAktualizator.Services">
    <DockPanel Margin="4,12,4,4">
        <WrapPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Style="{StaticResource ToolButton}" Tag="&#xE895;" Content="{l:Tr 'Szukaj aktualizacji Windows'}" Click="Search_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE896;" Content="{l:Tr 'Pobierz zaznaczone'}" Click="Download_Click" />
            <Button Style="{StaticResource AccentToolButton}" Tag="&#xE896;" Content="{l:Tr 'Instaluj pobrane'}" Click="Install_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE8B7;" Content="{l:Tr 'Instaluj plik MSU...'}" Click="InstallFile_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE8F1;" Content="{l:Tr 'Katalog Microsoft Update'}" Click="Catalog_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE721;" Content="{l:Tr 'Skanuj komputer offline...'}" Click="OfflineScan_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE8B7;" Content="{l:Tr 'Utwórz paczkę offline'}" Click="Offline_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE74E;" Content="{l:Tr 'Eksportuj raport'}" Click="Export_Click" />
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="2,0,2,8" TextWrapping="Wrap"
                   Text="{l:Tr 'Lista dotyczy tego komputera i skonfigurowanej usługi Windows Update. Brak identyfikatorów CVE w metadanych nie oznacza braku podatności.'}" />
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="False">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" Margin="0,0,8,0" />
            <TextBlock Text="{l:Tr 'Filtr:'}" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="260" Margin="8,0,16,0" TextChanged="Filter_Changed" />
            <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Style="{StaticResource Secondary}" />
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="2,8,2,0">
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Visibility="Hidden" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" Text="{l:Tr 'Gotowy.'}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="120" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" MinHeight="80" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="Table" Style="{StaticResource Grid}" SelectionChanged="Table_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr 'Aktualizacja'}" Binding="{Binding Title}" Width="3*" MinWidth="250" />
                    <DataGridTextColumn Header="KB" Binding="{Binding KbText}" Width="140" />
                    <DataGridTextColumn Header="CVE" Binding="{Binding CveText}" Width="2*" MinWidth="150" />
                    <DataGridTextColumn Header="{l:Tr 'Ważność'}" Binding="{Binding Severity}" Width="110" />
                    <DataGridTextColumn Header="{l:Tr 'Rozmiar'}" Binding="{Binding SizeText}" Width="100" />
                    <DataGridTextColumn Header="{l:Tr 'Status'}" Binding="{Binding DownloadText}" Width="110" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
            <TabControl x:Name="BottomTabs" Grid.Row="2">
                <TabItem Header="{l:Tr 'Szczegóły'}">
                    <TextBox x:Name="Details" Style="{StaticResource LogBox}" />
                </TabItem>
                <TabItem Header="{l:Tr 'Dziennik'}">
                    <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
