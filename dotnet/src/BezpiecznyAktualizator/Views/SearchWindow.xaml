<Window x:Class="BezpiecznyAktualizator.Views.SearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services"
        Width="820" Height="440" MinWidth="500" MinHeight="300"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <TextBlock x:Name="Header" DockPanel.Dock="Top" Margin="0,0,0,4" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                   Text="{l:Tr 'Scoop Main: zwykle Średnie zaufanie (skrypty lub brak SHA256 obniżają ocenę). Chocolatey Community: zawsze Niskie zaufanie; pakiety mogą uruchamiać skrypty. Winget: pełna ocena manifestu po powiązaniu.'}" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0" LastChildFill="False">
            <TextBlock x:Name="EmptyLabel" Text="{l:Tr 'Nie znaleziono pasujących pakietów.'}" VerticalAlignment="Center"
                       Visibility="Collapsed" />
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Zamknij'}" Padding="12,4" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Otwórz stronę pakietu'}" Padding="10,4" Margin="0,0,6,0"
                    Click="Open_Click" />
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Powiąż i oceń źródło'}" Padding="10,4" Margin="0,0,6,0"
                    IsDefault="True" Click="Link_Click" />
        </DockPanel>
        <TextBlock x:Name="ErrorsLabel" DockPanel.Dock="Bottom" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
        <DataGrid x:Name="Results" Style="{StaticResource Grid}" SelectionMode="Single"
                  MouseDoubleClick="Results_DoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="{l:Tr 'Nazwa'}" Binding="{Binding Name}" Width="2*" />
                <DataGridTextColumn Header="{l:Tr 'Identyfikator'}" Binding="{Binding Id}" Width="2*" />
                <DataGridTextColumn Header="{l:Tr 'Wersja'}" Binding="{Binding Version}" Width="110" />
                <DataGridTextColumn Header="{l:Tr 'Źródło'}" Binding="{Binding Source}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
