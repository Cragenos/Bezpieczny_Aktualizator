<UserControl x:Class="BezpiecznyAktualizator.Views.SoftwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services">
    <DockPanel Margin="4,12,4,4">
        <WrapPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="0,0,0,4">
            <Button Style="{StaticResource ToolButton}" Tag="&#xE72C;" Content="{l:Tr 'Skanuj komputer'}" Click="Scan_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE895;" Content="{l:Tr 'Sprawdź aktualizacje'}" Click="CheckUpdates_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xEA18;" Content="{l:Tr 'Oceń źródło'}" Click="Assess_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE9D5;" Content="{l:Tr 'Oceń wszystkie aktualizacje'}" Click="AssessAll_Click" />
            <Button Style="{StaticResource AccentToolButton}" Tag="&#xE896;" Content="{l:Tr 'Aktualizuj zaznaczone'}" Click="Upgrade_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE7BA;" Content="{l:Tr 'Sprawdź podatności i wsparcie'}" Click="Risk_Click"
                    ToolTip="{l:Tr 'Sprawdza znane podatności (CVE) zainstalowanych wersji w bazie NVD oraz wsparcie producenta (endoflife.date, aktywność projektu). Dotyczy zaznaczonych programów, a gdy nic nie zaznaczono - wszystkich.'}" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE7A7;" Content="{l:Tr 'Historia i wycofanie'}" Click="History_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE8D7;" Content="{l:Tr 'Zasady'}" Click="Policies_Click"
                    ToolTip="{l:Tr 'Wykluczone programy, wstrzymane wersje i wymagany poziom zaufania źródeł aktualizacji.'}" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE721;" Content="{l:Tr 'Szukaj w repozytorium'}" Click="Search_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE774;" Content="{l:Tr 'Strona producenta'}" Click="Homepage_Click" />
            <Button Style="{StaticResource ToolButton}" Tag="&#xE78C;" Content="{l:Tr 'Eksportuj raport'}" Click="Export_Click" />
        </WrapPanel>

        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10" LastChildFill="False">
            <TextBlock Style="{StaticResource Icon}" Text="&#xE71C;" Margin="0,0,8,0" />
            <TextBlock Text="{l:Tr 'Filtr:'}" VerticalAlignment="Center" />
            <TextBox x:Name="FilterBox" Width="280" Margin="8,0,16,0" VerticalContentAlignment="Center"
                     TextChanged="Filter_Changed" />
            <CheckBox x:Name="OnlyUpdates" Content="{l:Tr 'Tylko z dostępną aktualizacją'}" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <CheckBox x:Name="OnlyRisky" Content="{l:Tr 'Tylko pilne i nieobsługiwane'}" VerticalAlignment="Center" Margin="12,0,0,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed" />
            <CheckBox x:Name="VerifyTls" Content="{l:Tr 'Weryfikuj certyfikaty TLS serwerów'}" IsChecked="True"
                      VerticalAlignment="Center" Margin="12,0,0,0" />
            <CheckBox x:Name="VerifyChecksums" Content="{l:Tr 'Sprawdzaj pliki kontrolne przed instalacją'}" IsChecked="True"
                      VerticalAlignment="Center" Margin="12,0,0,0" Click="VerifyChecksums_Click"
                      ToolTip="{l:Tr 'Przed instalacją instalator jest pobierany, porównywany z sumą SHA256 z manifestu i z plikami kontrolnymi wydawcy (SHA256SUMS, *.sha256, GitHub Releases), sprawdzany jest jego podpis cyfrowy oraz jest skanowany programem Microsoft Defender.'}" />
            <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Style="{StaticResource Secondary}" />
        </DockPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="2,8,2,0">
            <ProgressBar x:Name="Progress" DockPanel.Dock="Right" Width="220" Visibility="Hidden" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" Text="{l:Tr 'Gotowy.'}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" MinHeight="120" />
                <RowDefinition Height="12" />
                <RowDefinition Height="2*" MinHeight="80" />
            </Grid.RowDefinitions>
            <DataGrid x:Name="Table" Style="{StaticResource Grid}" RowStyle="{StaticResource SoftwareRow}" SelectionChanged="Table_SelectionChanged"
                      MouseDoubleClick="Table_DoubleClick" ContextMenuOpening="Table_ContextMenuOpening">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem x:Name="ExcludeItem" Header="{l:Tr 'Wyklucz z aktualizacji'}" Click="Exclude_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8D8;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="HoldItem" Header="{l:Tr 'Wstrzymaj na bieżącej wersji'}" Click="Hold_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE72E;" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem x:Name="RemoveRuleItem" Header="{l:Tr 'Usuń zasadę'}" Click="RemoveRule_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE785;" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{l:Tr 'Zasady aktualizacji...'}" Click="Policies_Click">
                            <MenuItem.Icon><TextBlock Style="{StaticResource Icon}" Text="&#xE8D7;" /></MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{l:Tr 'Nazwa'}" Binding="{Binding Name}" Width="2*" MinWidth="200" />
                    <DataGridTextColumn Header="{l:Tr 'Wersja'}" Binding="{Binding Version}" Width="110" />
                    <DataGridTextColumn Header="{l:Tr 'Dostępna'}" Binding="{Binding AvailableDisplay}" Width="110" />
                    <DataGridTextColumn Header="{l:Tr 'Status'}" Binding="{Binding Status}" Width="150" />
                    <DataGridTextColumn Header="{l:Tr 'Zasada'}" Binding="{Binding PolicyDisplay}" Width="140" />
                    <DataGridTextColumn Header="{l:Tr 'Ryzyko'}" Binding="{Binding RiskDisplay}" Width="170" />
                    <DataGridTextColumn Header="{l:Tr 'Wydawca'}" Binding="{Binding Publisher}" Width="*" MinWidth="140" />
                    <DataGridTextColumn Header="{l:Tr 'Źródło aktualizacji'}" Binding="{Binding SourceDisplay}" Width="130" />
                    <DataGridTextColumn Header="{l:Tr 'Zaufanie'}" Binding="{Binding SecurityLevelDisplay}" Width="90" />
                    <DataGridTextColumn Header="{l:Tr 'Identyfikator pakietu'}" Binding="{Binding IdDisplay}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>
            <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
            <TabControl x:Name="BottomTabs" Grid.Row="2">
                <TabItem Header="{l:Tr 'Szczegóły i ocena źródła'}">
                    <TextBox x:Name="Details" Style="{StaticResource LogBox}" />
                </TabItem>
                <TabItem Header="{l:Tr 'Dziennik'}">
                    <TextBox x:Name="LogBox" Style="{StaticResource LogBox}" />
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
