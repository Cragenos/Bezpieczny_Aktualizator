<Window x:Class="BezpiecznyAktualizator.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services"
        Title="{l:Tr 'O programie'}"
        Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24,20,24,16">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <Border Width="56" Height="56" CornerRadius="12" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="30" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Bezpieczny Aktualizator" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="VersionText" Style="{StaticResource Secondary}" />
                </StackPanel>
            </StackPanel>

            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                <Grid x:Name="AuthorGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock x:Name="ProtectionIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;"
                                   FontSize="16" Margin="0,1,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{l:Tr 'Bezpieczeństwo pliku programu'}" FontWeight="SemiBold" />
                    </DockPanel>
                    <Grid x:Name="SecurityGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="170" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap"
                       Text="{l:Tr 'Program korzysta z projektów open source: .NET i WPF, winget-cli i winget-pkgs, System.Management, PDFsharp i Obfuscar oraz z danych NVD (NIST), OSV, FIRST EPSS, CISA KEV i endoflife.date.'}" />
        </StackPanel>

        <Border Grid.Row="1" Padding="24,16" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Padding="14,6" Click="Copy_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8C8;" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr 'Kopiuj informacje'}" />
                    </StackPanel>
                </Button>
                <Button Content="{l:Tr 'Zamknij'}" MinWidth="96" Padding="16,6" HorizontalAlignment="Right"
                        Style="{DynamicResource AccentButtonStyle}" IsDefault="True" IsCancel="True" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
