<Window x:Class="BezpiecznyAktualizator.Views.LocalAgentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services"
        Title="{l:Tr 'Lokalny agent AI'}"
        Width="680" Height="720" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="TestButton" Content="{l:Tr 'Testuj połączenie'}" Padding="12,5" Click="Test_Click" />
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Anuluj'}" Padding="12,5" Margin="8,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Zapisz'}" Padding="12,5" Margin="8,0,0,0"
                    Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Save_Click" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE99A;" FontSize="28"
                               Margin="0,2,16,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{l:Tr 'Podłącz model językowy działający na tym komputerze (np. Ollama, LM Studio, llama.cpp lub LocalAI z API zgodnym z OpenAI). Agent decyduje, które z dopuszczonych aktualizacji zainstalować teraz, a które odłożyć. Dane o aktualizacjach nie opuszczają komputera.'}" />
                </DockPanel>

                <CheckBox x:Name="EnabledBox" FontWeight="SemiBold" Content="{l:Tr 'Włącz lokalnego agenta AI'}" />

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Adres API (tylko localhost)'}" Margin="0,0,0,4" />
                        <TextBox x:Name="EndpointBox" AutomationProperties.Name="{l:Tr 'Adres API (tylko localhost)'}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="{l:Tr 'Ollama: http://127.0.0.1:11434/v1 · LM Studio: http://127.0.0.1:1234/v1 · llama.cpp: http://127.0.0.1:8080/v1'}" />

                        <TextBlock Text="{l:Tr 'Model'}" Margin="0,10,0,4" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Padding="12,4" Margin="8,0,0,0" Click="Test_Click"
                                    Content="{l:Tr 'Pobierz listę modeli'}" />
                            <ComboBox x:Name="ModelBox" IsEditable="True" AutomationProperties.Name="{l:Tr 'Model'}" />
                        </DockPanel>

                        <WrapPanel Margin="0,10,0,0">
                            <TextBlock Text="{l:Tr 'Limit czasu odpowiedzi (s):'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox x:Name="TimeoutBox" Width="80" AutomationProperties.Name="{l:Tr 'Limit czasu odpowiedzi (s):'}" />
                            <TextBlock Text="10–600" Style="{StaticResource Secondary}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </WrapPanel>

                        <CheckBox x:Name="ScheduledBox" Margin="0,12,0,0"
                                  Content="{l:Tr 'Ciche aktualizacje instalują tylko programy zatwierdzone przez agenta'}"
                                  ToolTip="{l:Tr 'Gdy agent jest niedostępny lub odpowie nieprawidłowo, ciche instalacje programów są pomijane.'}" />

                        <TextBlock Text="{l:Tr 'Wskazówki dla agenta (opcjonalnie)'}" Margin="0,12,0,4" />
                        <TextBox x:Name="InstructionsBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"
                                 VerticalScrollBarVisibility="Auto" MaxLength="2000"
                                 AutomationProperties.Name="{l:Tr 'Wskazówki dla agenta (opcjonalnie)'}" />
                        <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="{l:Tr 'Np.: Nie aktualizuj przeglądarek od poniedziałku do piątku. Zawsze instaluj aktualizacje 7-Zip i Notepad++.'}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE72E;" Margin="0,2,10,0"
                                   VerticalAlignment="Top" />
                        <TextBlock TextWrapping="Wrap"
                                   Text="{l:Tr 'Agent może tylko zawęzić listę aktualizacji dopuszczonych przez zasady. Nie może dodać pakietu, zmienić źródła ani pominąć weryfikacji sum kontrolnych i podpisu, punktu przywracania czy skanowania antywirusowego. Pakiet bez jednoznacznej zgody agenta jest odkładany.'}" />
                    </DockPanel>
                </Border>

                <TextBlock x:Name="StatusText" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,12,0,0" />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
