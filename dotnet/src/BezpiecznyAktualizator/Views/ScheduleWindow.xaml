<Window x:Class="BezpiecznyAktualizator.Views.ScheduleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services"
        Title="{l:Tr 'Harmonogram cichych aktualizacji'}"
        Width="740" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,16">
                <DockPanel Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE916;" FontSize="28"
                               Margin="0,2,16,0" VerticalAlignment="Top" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock TextWrapping="Wrap"
                               Text="{l:Tr 'Program może sam sprawdzać i instalować aktualizacje, gdy nie korzystasz z komputera. Zadanie jest uruchamiane przez Harmonogram zadań Windows tylko wtedy, gdy jesteś zalogowany, a komputer jest bezczynny i zasilany z sieci.'}" />
                </DockPanel>

                <CheckBox x:Name="EnabledBox" FontWeight="SemiBold" Margin="0,0,0,10" Click="Enabled_Click"
                          Content="{l:Tr 'Włącz ciche sprawdzanie podczas bezczynności komputera'}" />

                <Border x:Name="OptionsCard" Style="{StaticResource Card}" Padding="16,12">
                    <StackPanel>
                        <TextBlock Text="{l:Tr 'Tryb działania'}" FontWeight="SemiBold" Margin="0,0,0,6" />
                        <RadioButton x:Name="ModeCheck" GroupName="Mode" Click="Mode_Click"
                                     Content="{l:Tr 'Tylko sprawdzaj dostępne wersje (wynik pokazany po uruchomieniu programu)'}" />
                        <RadioButton x:Name="ModeInstall" GroupName="Mode" Click="Mode_Click"
                                     Content="{l:Tr 'Sprawdzaj i instaluj aktualizacje z zaufanych źródeł'}" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="{l:Tr 'Rozpocznij po bezczynności (min):'}" VerticalAlignment="Center" Margin="0,0,12,6" />
                            <ComboBox x:Name="IdleBox" Grid.Column="1" Width="220" HorizontalAlignment="Left" Margin="0,0,0,6"
                                      AutomationProperties.Name="{l:Tr 'Rozpocznij po bezczynności (min):'}" />
                            <TextBlock Grid.Row="1" Text="{l:Tr 'Nie częściej niż co (godz.):'}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <ComboBox x:Name="IntervalBox" Grid.Row="1" Grid.Column="1" Width="220" HorizontalAlignment="Left"
                                      AutomationProperties.Name="{l:Tr 'Nie częściej niż co (godz.):'}" />
                        </Grid>
                        <WrapPanel Margin="0,12,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr 'Okno serwisowe od:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="WindowStartBox" Width="88" Margin="0,0,16,0"
                                      AutomationProperties.Name="{l:Tr 'Okno serwisowe od:'}" />
                            <TextBlock Text="{l:Tr 'do:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="WindowEndBox" Width="88"
                                      AutomationProperties.Name="{l:Tr 'Okno serwisowe do:'}" />
                            <TextBlock Text="{l:Tr '00:00–00:00 oznacza cały dzień.'}" Style="{StaticResource Secondary}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                        </WrapPanel>
                        <CheckBox x:Name="SkipBatteryBox" Margin="0,10,0,0"
                                  Content="{l:Tr 'Pomijaj instalacje, gdy komputer działa na baterii'}" />
                        <CheckBox x:Name="SkipMeteredBox" Margin="0,4,0,0"
                                  Content="{l:Tr 'Pomijaj instalacje w sieci taryfowej lub o nieznanym koszcie'}" />
                        <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{l:Tr 'Ponów nieudaną instalację maksymalnie:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="RetriesBox" Width="90"
                                      AutomationProperties.Name="{l:Tr 'Maksymalna liczba ponowień instalacji'}" />
                            <TextBlock Text="{l:Tr 'po 30, 60 i 90 sekundach (maks.)'}" Style="{StaticResource Secondary}"
                                       VerticalAlignment="Center" Margin="8,0,0,0" />
                        </WrapPanel>
                        <CheckBox x:Name="NoScanBox" Margin="0,8,0,0"
                                  Content="{l:Tr 'Instaluj także wtedy, gdy Microsoft Defender jest niedostępny (bez skanowania antywirusowego)'}"
                                  ToolTip="{l:Tr 'Domyślnie pakiety, których instalator nie mógł zostać przeskanowany programem Microsoft Defender (np. gdy działa inny antywirus), są pomijane.'}" />

                        <TextBlock Text="{l:Tr 'Sterowniki'}" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <CheckBox x:Name="DriversCheckBox" Click="Mode_Click"
                                  Content="{l:Tr 'Sprawdzaj sterowniki w Windows Update'}" />
                        <CheckBox x:Name="DriversInstallBox" Margin="24,2,0,0"
                                  Content="{l:Tr 'Instaluj sterowniki automatycznie (z punktem przywracania systemu)'}" />

                        <TextBlock Text="{l:Tr 'Windows Update'}" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <CheckBox x:Name="WindowsUpdatesCheckBox" Click="Mode_Click"
                                  Content="{l:Tr 'Sprawdzaj aktualizacje Windows w harmonogramie'}" />
                        <CheckBox x:Name="WindowsUpdatesInstallBox" Margin="24,2,0,0"
                                  Content="{l:Tr 'Instaluj automatycznie tylko obowiązkowe aktualizacje z wcześniej zaakceptowaną licencją'}" />

                        <TextBlock Text="{l:Tr 'Zasady aktualizacji'}" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Padding="12,4" Margin="12,0,0,0" VerticalAlignment="Top"
                                    Click="Policies_Click" Content="{l:Tr 'Zasady aktualizacji...'}" />
                            <TextBlock x:Name="PolicySummary" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,12,0,0"
                           Text="{l:Tr 'Bez udziału użytkownika instalowane są wyłącznie pakiety, których instalator przeszedł weryfikację sumy SHA-256, podpisu cyfrowego i skanowanie programem Microsoft Defender. Pozostałe są pomijane i opisane w dzienniku. Instalacja zostaje przerwana przed kolejnym pakietem, gdy wrócisz do komputera.'}" />
                <TextBlock x:Name="TaskInfo" Style="{StaticResource Secondary}" TextWrapping="Wrap" Margin="0,8,0,0" />

                <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,12,0,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" Text="&#xE81C;" Margin="0,2,10,0"
                                   VerticalAlignment="Top" />
                        <TextBlock x:Name="LastRunText" TextWrapping="Wrap" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="24,16" BorderThickness="0,1,0,0"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button x:Name="RunNowButton" DockPanel.Dock="Left" Padding="14,6" Click="RunNow_Click"
                        ToolTip="{l:Tr 'Uruchamia ciche sprawdzanie od razu, z bieżącymi ustawieniami (wymaga uprawnień administratora do instalacji).'}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE768;" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock Text="{l:Tr 'Uruchom teraz'}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="SaveButton" Content="{l:Tr 'Zapisz'}" MinWidth="96" Padding="16,6" Margin="8,0,0,0"
                            Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Save_Click" />
                    <Button Content="{l:Tr 'Anuluj'}" MinWidth="96" Padding="16,6" Margin="8,0,0,0" IsCancel="True" />
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
