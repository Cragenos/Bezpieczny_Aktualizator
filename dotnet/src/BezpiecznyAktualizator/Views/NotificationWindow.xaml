<Window x:Class="BezpiecznyAktualizator.Views.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services"
        Title="{l:Tr 'Powiadomienia'}"
        Width="680" Height="740" MinWidth="560" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <DockPanel Margin="16">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button Content="{l:Tr 'Wyślij test'}" Padding="12,5" Click="Test_Click" />
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Anuluj'}" Padding="12,5" Margin="8,0,0,0" IsCancel="True" />
            <Button DockPanel.Dock="Right" Content="{l:Tr 'Zapisz'}" Padding="12,5" Margin="8,0,0,0"
                    Style="{DynamicResource AccentButtonStyle}" IsDefault="True" Click="Save_Click" />
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" Style="{StaticResource Secondary}" Margin="0,0,0,12"
                           Text="{l:Tr 'Opcjonalne podsumowanie wyników cichych aktualizacji. Sekrety są szyfrowane DPAPI dla bieżącego konta Windows; adres webhooka nie jest zapisywany w dzienniku.'}" />
                <CheckBox x:Name="EnabledBox" Content="{l:Tr 'Włącz powiadomienia po cichym sprawdzaniu'}" FontWeight="SemiBold" />

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,12,0,0">
                    <StackPanel>
                        <CheckBox x:Name="TeamsEnabledBox" Content="{l:Tr 'Microsoft Teams (webhook)'}" FontWeight="SemiBold" />
                        <TextBlock Text="{l:Tr 'Adres webhooka HTTPS'}" Margin="0,10,0,4" />
                        <PasswordBox x:Name="TeamsWebhookBox" />
                        <TextBlock x:Name="TeamsStatusText" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        <CheckBox x:Name="ClearTeamsBox" Content="{l:Tr 'Usuń zapisany webhook'}" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Padding="14" Margin="0,10,0,0">
                    <StackPanel>
                        <CheckBox x:Name="EmailEnabledBox" Content="{l:Tr 'E-mail (SMTP z TLS)'}" FontWeight="SemiBold" />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{l:Tr 'Serwer SMTP'}" Margin="0,0,0,4" />
                                <TextBox x:Name="SmtpHostBox" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{l:Tr 'Port'}" Margin="0,0,0,4" />
                                <TextBox x:Name="SmtpPortBox" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="{l:Tr 'Nazwa użytkownika'}" Margin="0,8,0,4" />
                        <TextBox x:Name="SmtpUserBox" />
                        <TextBlock Text="{l:Tr 'Hasło SMTP'}" Margin="0,8,0,4" />
                        <PasswordBox x:Name="SmtpPasswordBox" />
                        <TextBlock x:Name="SmtpStatusText" Style="{StaticResource Secondary}" Margin="0,4,0,0" />
                        <CheckBox x:Name="ClearSmtpPasswordBox" Content="{l:Tr 'Usuń zapisane hasło'}" Margin="0,6,0,0" />
                        <TextBlock Text="{l:Tr 'Adres nadawcy'}" Margin="0,8,0,4" />
                        <TextBox x:Name="SmtpFromBox" />
                        <TextBlock Text="{l:Tr 'Adres odbiorcy'}" Margin="0,8,0,4" />
                        <TextBox x:Name="SmtpToBox" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
