<Window x:Class="BezpiecznyAktualizator.Views.OfflinePackageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services"
        Title="{l:Tr 'Paczka aktualizacji offline'}"
        Width="800" Height="610" MinWidth="620" MinHeight="460"
    WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Closing="Window_Closing" Closed="Window_Closed">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{l:Tr 'Dodaj kompletne pliki MSU lub serwisowe CAB pobrane ręcznie z Katalogu Microsoft Update. Pamięć pobrań Windows Update nie jest przenośną paczką.'}" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Secondary}" Margin="0,0,0,10"
                   Text="{l:Tr 'Dobierz pliki i wymagane aktualizacje wstępne do wersji oraz architektury komputera offline. Ustaw kolejność instalacji. Wymagany jest zaufany certyfikat podpisywania kodu; skrypt instalatora jest podpisany Authenticode, a manifest ma podpis RSA.'}" />
            <TextBlock TextWrapping="Wrap" Style="{StaticResource Secondary}" Margin="0,0,0,10"
                       Text="{l:Tr 'Przed instalacją zapoznaj się z warunkami licencji każdej aktualizacji. Instalator offline ich nie wyświetla.'}" />
        <DockPanel Margin="0,0,0,4">
            <TextBlock Text="{l:Tr 'Certyfikat podpisujący:'}" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox x:Name="SignerBox" DisplayMemberPath="Label" MinWidth="300" SelectionChanged="Signer_Changed" />
        </DockPanel>
        <TextBlock TextWrapping="Wrap" Style="{StaticResource Secondary}" Margin="0,2,0,2"
                   Text="{l:Tr 'Zapisz ten odcisk i przekaż go na komputer offline niezależnym, zaufanym kanałem. Na komputerze docelowym certyfikat wydawcy musi być zaufany przez Windows; nie uruchamiaj skryptu, jeśli podpis Authenticode nie jest prawidłowy.'}" />
        <TextBox x:Name="SignerFingerprint" IsReadOnly="True" Margin="0,0,0,8"
                 ToolTip="{l:Tr 'Odcisk SHA-256 certyfikatu podpisującego'}" />
    </StackPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <ProgressBar x:Name="Progress" DockPanel.Dock="Top" Height="6" Visibility="Hidden" IsIndeterminate="True" />
            <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Secondary}" Margin="0,6,0,6" />
            <WrapPanel x:Name="BottomButtons" HorizontalAlignment="Right">
                <Button Content="{l:Tr 'Anuluj'}" Padding="12,5" Margin="0,0,8,0" IsCancel="True" />
                <Button Content="{l:Tr 'Utwórz ZIP'}" Padding="12,5" Style="{DynamicResource AccentButtonStyle}" Click="Create_Click" />
            </WrapPanel>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="FilesList" SelectionMode="Single" />
            <StackPanel x:Name="FileButtons" Grid.Column="1" Margin="10,0,0,0">
                <Button Content="{l:Tr 'Dodaj pliki...'}" Padding="12,5" Margin="0,0,0,6" Click="Add_Click" />
                <Button Content="{l:Tr 'Usuń'}" Padding="12,5" Margin="0,0,0,6" Click="Remove_Click" />
                <Button Content="{l:Tr 'W górę'}" Padding="12,5" Margin="0,0,0,6" Click="Up_Click" />
                <Button Content="{l:Tr 'W dół'}" Padding="12,5" Click="Down_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
