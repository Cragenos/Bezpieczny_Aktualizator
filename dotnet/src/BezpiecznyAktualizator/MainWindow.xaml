<Window x:Class="BezpiecznyAktualizator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BezpiecznyAktualizator.Services"
        xmlns:views="clr-namespace:BezpiecznyAktualizator.Views"
        Title="{l:Tr 'Bezpieczny Aktualizator 2.1 – oprogramowanie i sterowniki z bezpiecznych źródeł'}"
        Width="1380" Height="840" MinWidth="980" MinHeight="560"
        Closing="Window_Closing" StateChanged="Window_StateChanged"
        WindowStartupLocation="CenterScreen" ContentRendered="OnContentRendered">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Nagłówek aplikacji -->
        <Grid Grid.Row="0" Margin="18,12,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentFillColorDefaultBrush}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xEA18;" FontSize="22" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Bezpieczny Aktualizator" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Secondary}" TextTrimming="CharacterEllipsis"
                               Text="{l:Tr 'Oprogramowanie i sterowniki z bezpiecznych źródeł'}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AutoCheckButton" Style="{StaticResource HeaderButton}" Tag="&#xE895;"
                        Content="{l:Tr 'Sprawdzanie przy starcie ▾'}" Click="AutoCheck_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="AutoSoftware" Header="{l:Tr 'Sprawdzaj aktualizacje programów po uruchomieniu'}"
                                      IsCheckable="True" Click="AutoOption_Click" />
                            <MenuItem x:Name="AutoDrivers" Header="{l:Tr 'Sprawdzaj sterowniki w Windows Update po uruchomieniu'}"
                                      IsCheckable="True" Click="AutoOption_Click" />
                            <MenuItem x:Name="AutoAppUpdates" Header="{l:Tr 'Sprawdzaj aktualizacje programu po uruchomieniu'}"
                                      IsCheckable="True" Click="AutoAppUpdates_Click" />
                            <Separator />
                            <MenuItem Header="{l:Tr 'Sprawdź teraz'}" Click="CheckNow_Click" />
                            <Separator />
                            <MenuItem Header="{l:Tr 'Harmonogram cichych aktualizacji...'}" Click="Schedule_Click" />
                            <MenuItem Header="{l:Tr 'Zasady aktualizacji...'}" Click="Policies_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button x:Name="LogFileButton" Style="{StaticResource HeaderButton}" Tag="&#xE8A5;" Margin="0,0,16,0"
                        Content="{l:Tr 'Dziennik zdarzeń (syslog)'}" Click="LogFile_Click" />
                <TextBlock Style="{StaticResource Icon}" Text="&#xE793;" FontSize="16" Margin="0,0,8,0"
                           ToolTip="{l:Tr 'Motyw:'}" />
                <ComboBox x:Name="ThemeBox" Width="130" Margin="0,0,16,0" SelectionChanged="Theme_Changed"
                          AutomationProperties.Name="{l:Tr 'Motyw:'}" ToolTip="{l:Tr 'Motyw:'}">
                    <ComboBoxItem Tag="System" Content="{l:Tr 'Systemowy'}" />
                    <ComboBoxItem Tag="Light" Content="{l:Tr 'Jasny'}" />
                    <ComboBoxItem Tag="Dark" Content="{l:Tr 'Ciemny'}" />
                </ComboBox>
                <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" FontSize="16" Margin="0,0,8,0"
                           ToolTip="{l:Tr 'Język:'}" />
                <ComboBox x:Name="LanguageBox" Width="170" SelectionChanged="Language_Changed"
                          AutomationProperties.Name="{l:Tr 'Język:'}" ToolTip="{l:Tr 'Język:'}" />
                <Button x:Name="AboutButton" Margin="8,0,0,0" Padding="9,7" Click="About_Click"
                        ToolTip="{l:Tr 'O programie'}" AutomationProperties.Name="{l:Tr 'O programie'}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE946;" FontSize="16" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Wynik automatycznego sprawdzania wersji po uruchomieniu (pasek informacyjny) -->
        <Border x:Name="StartupBanner" Grid.Row="1" Visibility="Collapsed" Margin="18,0,18,10" Padding="14,8"
                CornerRadius="6" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource InfoBarInformationalSeverityBackgroundBrush}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="BannerIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="16"
                           Margin="0,0,12,0" Text="&#xE946;" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                <Button DockPanel.Dock="Right" Click="CloseBanner_Click" Padding="8,4" Margin="8,0,0,0"
                        Background="Transparent" BorderThickness="0" ToolTip="{l:Tr 'Zamknij'}" AutomationProperties.Name="{l:Tr 'Zamknij'}">
                    <TextBlock Style="{StaticResource Icon}" Text="&#xE711;" FontSize="12" />
                </Button>
                <Button x:Name="ShowDriverUpdates" DockPanel.Dock="Right" Content="{l:Tr 'Pokaż sterowniki'}" Padding="12,4"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="ShowDriverUpdates_Click" />
                <Button x:Name="ShowSoftwareUpdates" DockPanel.Dock="Right" Content="{l:Tr 'Pokaż programy'}" Padding="12,4"
                        Margin="8,0,0,0" Visibility="Collapsed" Click="ShowSoftwareUpdates_Click" />
                <TextBlock x:Name="BannerText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <TabControl x:Name="Tabs" Grid.Row="2" Margin="12,0,12,12">
            <TabItem AutomationProperties.Name="{l:Tr 'Oprogramowanie'}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE7B8;" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Tr 'Oprogramowanie'}" />
                    </StackPanel>
                </TabItem.Header>
                <views:SoftwareView x:Name="Software" />
            </TabItem>
            <TabItem AutomationProperties.Name="{l:Tr 'Sterowniki'}">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE772;" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Tr 'Sterowniki'}" />
                    </StackPanel>
                </TabItem.Header>
                <views:DriversView x:Name="Drivers" />
            </TabItem>
        </TabControl>
    </Grid>
</Window>